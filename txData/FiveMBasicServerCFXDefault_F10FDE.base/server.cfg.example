# Vorlage für server.cfg – enthält KEINE echten Secrets.
# Kopieren nach "server.cfg" im selben Ordner und die <PLATZHALTER> ausfüllen.
# Die echte server.cfg ist bewusst in .gitignore (enthält sv_licenseKey im
# Klartext), diese .example-Datei dient nur als versionierte Referenz für den
# strukturellen Aufbau/die gewählten Einstellungen. Details siehe CLAUDE.md.
#
# Original-Kommentar aus dem FiveM-Basic-Server-Recipe:
# This file is a minimal version of the default config file.
# This is NOT supposed to be enough for most servers.
# Please read the fivem documentation:
#   https://aka.cfx.re/server-commands
#   https://docs.fivem.net/docs/server-manual/setting-up-a-server/

## You SHOULD edit the following:
sv_hostname "<Dein Servername>"
sets sv_projectName "[FiveM Basic Server] <Dein Servername>"
sets sv_projectDesc "Recipe for the base resources required to run a minimal FiveM server."
sets tags "default, deployer"
sets locale "root-AQ"

## You CAN edit the following:
sv_enforceGameBuild 3258 #mp2024_01	- Bottom Dollar Bounties
# Eigenen Key holen unter https://keymaster.fivem.net/ (Register a new server)
sv_licenseKey "<DEIN_LICENSE_KEY>"
sv_maxclients 48
# Bewusst auf 127.0.0.1 statt 0.0.0.0 gesetzt -> Server nur lokal erreichbar
# (kein LAN-/Internet-Zugriff). Für echten Netzwerkbetrieb auf "0.0.0.0:30120"
# ändern und zusätzlich Windows-Firewall + Portforwarding einrichten.
endpoint_add_tcp "127.0.0.1:30120"
endpoint_add_udp "127.0.0.1:30120"
set steam_webApiKey "none"
set resources_useSystemChat true

## EasyAdmin
setr ea_LanguageName "de"                          # set our language to english
setr ae_alwaysShowButtons "false"                  # we don't want to see buttons we can't evan access, do we? default: "false"
set ea_moderationNotification "false"              # this can be either "false" or a discord webhook address, this will send a discord message if an admin takes actions against a player  ( such as banning and kicking )
set ea_custombanlist "false"                       # read docs for this, dont touch it
set ea_enableCallAdminCommand "true"
set ea_enableReportCommand "true"

## Datenbank (Core)
# MariaDB/MySQL-Zugang fuer die Core-Resource. Nur der Core spricht mit der DB,
# alle Feature-Resources gehen ueber dessen Exports/Events (siehe GDD "Core").
# Enthaelt Zugangsdaten -> in der echten server.cfg ausfuellen, hier Platzhalter.
# Benutzer/Datenbank werden per resources/[local]/core/sql/000_*.sql angelegt.
set mysql_connection_string "mysql://fivem:<DB_PASSWORT>@localhost/fivem?charset=utf8mb4"

## These resources will start by default.
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure basic-gamemode
ensure hardcap
ensure EasyAdmin

# oxmysql = Datenbank-Treiber (Fremd-Resource, gitignored). MUSS vor dem Core
# starten, der Core wiederum vor allen Feature-Resources.
ensure oxmysql

## Eigene Resources ([local]/)
# Reihenfolge ist relevant: core zuerst, danach alles, was ihn per
# "dependency 'core'" in der fxmanifest.lua voraussetzt.
ensure core
ensure basic-admin

## Add system admins
add_ace group.admin command allow # allow all commands
add_ace group.admin command.quit deny # but don't allow aquit
# Eigene Identifier per "/ea_printIdentifiers" (Chat-Befehl) im Server ermitteln.
add_principal identifier.fivem:<DEINE_FIVEM_ID> group.admin #<DeinName>
#add_principal identifier.steam:<DEINE_STEAM_ID> group.admin #<DeinName>
add_ace group.admin easyadmin allow
add_ace group.admin basicadmin allow
